{
  "name": "@rwdlol/ui",
  "version": "2.0.5",
  "description": "Custom Astro Components",
  "type": "module",
  "license": "MIT",
  "author": "Rawand <npm@rwd.lol>",
  "homepage": "https://www.rwd.lol/storybook/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rwdlol/rwdlol.git",
    "directory": "packages/ui"
  },
  "bugs": "https://github.com/rwdlol/rwdlol/issues",
  "keywords": [
    "astro"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./html": "./src/html.ts",
    "./integration": {
      "types": "./src/integration.d.ts",
      "default": "./src/integration.js"
    },
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/*.stories.ts",
    "!src/**/*.test.ts",
    "!src/**/*.example.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "astro": "latest"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "postcss": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
