---
// Internal: the HTML document shared by BaseLayout.
// Not exported. Header and footer come only from the user's slots.
import "@rwdlol/ui/styles/index.css";
import {
  canonicalUrl,
  type BaseLayoutProps,
} from "@rwdlol/ui/components/BaseLayout/BaseLayout.ts";

type Props = BaseLayoutProps & { bodyClass: string };

const {
  title,
  description,
  lang = "en",
  skipLinkLabel = "Skip to main content",
  bodyClass,
} = Astro.props;
const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class:list={["base-layout", bodyClass]}>
    <a class="skip-link" href="#main">
      {skipLinkLabel}
    </a>
    <slot name="header" />
    <slot />
    <slot name="footer" />
  </body>
</html>
