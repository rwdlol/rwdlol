---
import PageShell from "@rwdlol/ui/components/BaseLayout/PageShell.astro";
import type { BaseLayoutProps } from "@rwdlol/ui/components/BaseLayout/BaseLayout.ts";

type Props = BaseLayoutProps;
---

<PageShell {...Astro.props} bodyClass="base-layout--page">
  <slot name="head" slot="head" />
  <slot name="header" slot="header" />
  <main id="main" class="base-layout__main" tabindex="-1">
    <slot />
  </main>
  <slot name="footer" slot="footer" />
</PageShell>
