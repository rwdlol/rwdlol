{
  "name": "rwdlol",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "storybook": "storybook dev -p 6006",
    "build": "npm run build:site && npm run build:storybook",
    "build:site": "astro build",
    "build:storybook": "storybook build -o dist/storybook",
    "preview": "astro preview",
    "typecheck": "astro sync && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook"
  },
  "dependencies": {
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/html-vite": "^10.6.7",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "playwright": "latest",
    "storybook": "^10.6.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "latest"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
