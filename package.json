{
  "name": "rwdlol",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "storybook": "storybook dev -p 6006",
    "build": "npm run build:site && npm run build:storybook",
    "build:site": "astro build",
    "build:storybook": "storybook build -o dist/storybook",
    "preview": "astro preview",
    "typecheck": "astro sync && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook"
  },
  "dependencies": {
    "@rwdlol/ui": "*",
    "astro": "latest"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "latest",
    "@storybook/addon-docs": "latest",
    "@storybook/addon-vitest": "latest",
    "@storybook/html-vite": "latest",
    "@types/node": "latest",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "playwright": "latest",
    "storybook": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
