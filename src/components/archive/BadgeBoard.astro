---
import Badge from "./Badge.astro";

type Extra = "note" | "card" | "photo";

const badges: {
  image: string;
  alt: string;
  color: string;
  text: string;
  length: number;
  extras?: Extra[];
}[] = [
  {
    image: "/images/badges/01-gym.jpg",
    alt: "test",
    color: "#151517",
    text: "TEST 2025",
    length: 250,
    extras: ["card"],
  },
  {
    image: "/images/badges/02-coop.jpg",
    alt: "test",
    color: "#12a36b",
    text: "TEST 2025",
    length: 340,
  },
  {
    image: "/images/badges/03-cryptopulse.jpg",
    alt: "test",
    color: "#18181a",
    text: "TEST 2025",
    length: 240,
  },
  {
    image: "/images/badges/04-agentx.jpg",
    alt: "test",
    color: "#2338a8",
    text: "TEST 2025",
    length: 320,
    extras: ["note"],
  },
  {
    image: "/images/badges/05-ai-pioneers.jpg",
    alt: "test",
    color: "#7c3aed",
    text: "TEST 2025",
    length: 414,
  },
  {
    image: "/images/badges/06-cit.jpg",
    alt: "test",
    color: "#29b6e8",
    text: "TEST 2025",
    length: 297,
    extras: ["photo"],
  },
];

const count = `N°${String(badges.length).padStart(2, "0")} · 6 YR`;
---

<div class="archive">
  <div class="frame">
    <h2 class="plate">
      <i></i>
      FIELD ARCHIVE
      <i></i>
    </h2>

    <div class="board">
      <div class="rack" style={`--n:${badges.length}`}>
        {badges.map((b, i) => (
          <Badge
            id={`badge-${i + 1}`}
            image={b.image}
            alt={b.alt}
            color={b.color}
            text={b.text}
            length={b.length}
            extraSpace={b.extras?.includes("card") ? 150 : 0}
          >
            {b.extras?.includes("note") && (
              <>
                <img
                  class="note"
                  src="/images/extras/note.svg"
                  alt="Handwritten note"
                  loading="lazy"
                />
                <span
                  class="tack yellow"
                  style="left:calc(84 * var(--u)); top:calc(22 * var(--u))"
                ></span>
              </>
            )}
            {b.extras?.includes("photo") && (
              <>
                <img
                  class="photo"
                  src="/images/extras/photo.svg"
                  alt="Group photo"
                  loading="lazy"
                />
                <span
                  class="tack red"
                  style="left:calc(110 * var(--u)); top:calc(8 * var(--u))"
                ></span>
              </>
            )}
            {b.extras?.includes("card") && (
              <>
                <span
                  class="tack silver"
                  style="left:calc(6 * var(--u)); top:calc((var(--h) + 182) * var(--u))"
                ></span>
                <img
                  class="card"
                  src="/images/extras/card.jpg"
                  alt="Trading card"
                  loading="lazy"
                />
              </>
            )}
          </Badge>
        ))}
      </div>

      <div class="counter">{count}</div>
    </div>
  </div>
</div>

<style>
  .archive {
    --mono: "JetBrains Mono", ui-monospace, Menlo, Consolas, monospace;
    margin: 48px 0 24px;
    color: #f1ece1;

    .frame {
      position: relative;
      padding: 10px;
      background: linear-gradient(180deg, #2a2b2d, #1b1c1e);
      /* box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.08),
        0 30px 60px -20px rgba(0, 0, 0, 0.8),
        0 0 0 1px #000; */
    }

    .plate {
      margin: 0;
      position: absolute;
      left: 50%;
      top: -18px;
      z-index: 30;
      display: flex;
      align-items: center;
      gap: 18px;
      padding: 9px 18px;
      transform: translateX(-50%);
      white-space: nowrap;
      background: linear-gradient(180deg, #38393c, #222326);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.12),
        0 6px 14px rgba(0, 0, 0, 0.6),
        0 0 0 1px #000;
      font: 500 clamp(11px, 1.2vw, 14px) / 1 var(--mono);
      letter-spacing: 0.32em;
      color: #d9d6cf;
    }

    .plate i {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: radial-gradient(
        circle at 35% 35%,
        #d8d8d8,
        #5c5c5c 60%,
        #222
      );
    }

    .board {
      container-type: inline-size;
      position: relative;
      overflow: hidden;
      padding: clamp(26px, 3vw, 40px) clamp(14px, 2.4vw, 40px)
        clamp(56px, 6vw, 80px);
      background:
        radial-gradient(
          ellipse at 50% 0%,
          rgba(255, 220, 170, 0.07),
          transparent 60%
        ),
        radial-gradient(
          ellipse at 50% 120%,
          rgba(0, 0, 0, 0.55),
          transparent 60%
        ),
        url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .2  0 0 0 0 .14  0 0 0 0 .08  0 0 0 .55 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>"),
        light-dark(#0b57d0, #8ab4f8);

      box-shadow:
        inset 0 0 0 1px rgba(0, 0, 0, 0.6),
        inset 0 12px 30px rgba(0, 0, 0, 0.65),
        inset 0 -20px 40px rgba(0, 0, 0, 0.4);
    }
    .rack {
      /* --u = one "design pixel": all badges fit in one row, never bigger than 1px */
      --per: var(--n);
      --u: min(1px, calc((100cqw - 4px) / (var(--per) * 124)));
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      row-gap: calc(30 * var(--u));
    }
    @container (max-width: 560px) {
      .rack {
        --per: 5;
      }
    }
    .counter {
      position: absolute;
      right: clamp(16px, 3vw, 48px);
      bottom: clamp(18px, 2.4vw, 30px);
      font: 500 clamp(11px, 1.2vw, 15px) / 1 var(--mono);
      letter-spacing: 0.2em;
      color: rgba(241, 236, 225, 0.45);
    }

    .note {
      position: absolute;
      z-index: 1;
      top: calc(18 * var(--u));
      left: calc(-14 * var(--u));
      width: calc(200 * var(--u));
      transform: rotate(-4deg);
      filter: drop-shadow(0 10px 10px rgba(0, 0, 0, 0.5));
    }
    .photo {
      position: absolute;
      z-index: 7;
      top: calc(6 * var(--u));
      left: calc(-18 * var(--u));
      width: calc(230 * var(--u));
      transform: rotate(3deg);
      box-shadow: 0 12px 20px rgba(0, 0, 0, 0.55);
    }
    .card {
      position: absolute;
      z-index: 3;
      left: calc(-36 * var(--u));
      top: calc((var(--h) + 188) * var(--u));
      width: calc(112 * var(--u));
      border-radius: calc(7 * var(--u));
      transform: rotate(-6deg);
      box-shadow: 0 14px 20px -6px rgba(0, 0, 0, 0.75);
    }
    .tack {
      position: absolute;
      z-index: 8;
      width: calc(16 * var(--u));
      aspect-ratio: 1;
      border-radius: 50%;
      box-shadow: 0 3px 3px rgba(0, 0, 0, 0.6);
    }
    .tack.yellow {
      background: radial-gradient(
        circle at 35% 30%,
        #fff6c2,
        #f2b705 45%,
        #8a6400
      );
    }
    .tack.red {
      background: radial-gradient(
        circle at 35% 30%,
        #ffd1d1,
        #e11d2e 45%,
        #6e0710
      );
    }
    .tack.silver {
      background: radial-gradient(
        circle at 35% 30%,
        #f2f2f2,
        #9a9a9a 45%,
        #3c3c3c 80%
      );
    }
  }
</style>
