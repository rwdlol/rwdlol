---
import { ContactForm } from "./ContactForm";
import "./ContactForm.css";
---

<div data-contact-form-root>
  <Fragment set:html={ContactForm()} />
</div>

<script>
  import type { ContactValues } from "../../data/contactForm";
  import { initContactForm } from "./ContactForm.client";

  function logValuesUntilABackendExists(values: ContactValues) {
    console.log("Contact form submitted", values);
  }

  function initEveryContactForm() {
    for (const root of document.querySelectorAll("[data-contact-form-root]")) {
      initContactForm(root, logValuesUntilABackendExists);
    }
  }

  initEveryContactForm();
  document.addEventListener("astro:page-load", initEveryContactForm);
</script>
