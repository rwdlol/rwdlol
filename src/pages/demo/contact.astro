---
import BaseLayout from "@layouts/BaseLayout.astro";
import ContactForm from "@components/ContactForm/ContactForm.astro";
import { demoSite } from "@data/site";
---

<BaseLayout
  title="Contact – City Services Demo"
  description="Contact form demo."
  site={demoSite}
>
  <div class="container contact">
    <h1>Contact us</h1>
    <p>
      Fields marked with <span aria-hidden="true">*</span>
      <span class="sr-only">an asterisk</span> are required.
    </p>
    <ContactForm />
  </div>
</BaseLayout>

<style>
  .contact {
    max-width: 640px;
    margin-top: var(--space-8);
  }

  h1 {
    margin-bottom: var(--space-2);
  }
</style>
