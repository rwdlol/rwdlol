---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero/Hero.astro";
import Alert from "../components/Alert/Alert.astro";
import Card from "../components/Card/Card.astro";
import { services } from "../data/site";
---

<BaseLayout title="Home">
  <Hero
    title="Online services for residents"
    text="Apply for permits, book appointments and contact the administration, all in one place."
    primaryLabel="View services"
    primaryHref="#services"
    secondaryLabel="Contact us"
    secondaryHref="/contact"
  />

  <div class="container section">
    <Alert
      type="warning"
      title="Planned maintenance"
      message="The portal will be unavailable on Saturday from 8:00 to 12:00."
    />
  </div>

  <section
    class="container section"
    id="services"
    aria-labelledby="services-title"
  >
    <h2 id="services-title">Popular services</h2>
    <div class="grid">
      {services.map((service) => (
        <Card {...service} />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    margin-top: var(--space-8);
  }

  .grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
</style>
