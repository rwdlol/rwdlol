---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Hero, Card, SkillList } from "@rwdlol/ui";
import type { CardProps, SkillListProps } from "@rwdlol/ui";
import { mainSite, STORYBOOK_URL } from "../data/site";

export const awards: CardProps[] = [
  {
    title: "Skill 17 WorldSkills Germany",
    text: "Won the Silver Medal at WorldSkills Germany 2025 (Skill 17), qualifying for the Albert Einstein Cup 2026. There, I represented Germany against 11 nations and secured 5th place.",
    headingLevel: 3,
  },
];

export const skills: SkillListProps[] = [
  {
    title: "frontend",
    items: [
      "JS/TS",
      "React",
      "Next.js",
      "HTML/CSS",
      "SASS/SCSS",
      "Framer Motion",
    ],
  },
  {
    title: "backend",
    items: ["Laravel", "Node.js", "Express.js", "Bun", "PHP", "Rust"],
  },
  {
    title: "cloud / devops",
    items: ["Google Cloud", "Cloudflare", "Vercel", "DigitalOcean"],
  },
  {
    title: "tools",
    items: ["Git", "Docker", "Figma", "Postman", "VS Code", "Sublime Text"],
  },
  { title: "database", items: ["SQLite", "MySQL", "MariaDB", "PostgreSQL"] },
  { title: "cms", items: ["WordPress", "Drupal", "Blogger.com"] },
  {
    title: "server",
    items: ["Linux Ubuntu/Debian", "Nginx/Apache", "PM2", "cPanel"],
  },
  { title: "languages", items: ["Kurdish", "English", "Arabic", "German"] },
];
---

<BaseLayout
  title="Rawand Khalid – Full-stack web developer"
  description="Rawand Khalid is a full-stack web developer: frontend, backend, databases, cloud, DevOps, CMS and server management."
  site={mainSite}
>
  <Hero
    title="Rawand Khalid"
    text="I am a full-stack web developer with experience in building, deploying, and maintaining modern web applications. My work covers frontend development, backend systems, databases, cloud platforms, DevOps workflows, CMS platforms, and server management."
    ,
    primaryLabel="View design system"
    primaryHref="/demo/"
    secondaryLabel="Open Storybook"
    secondaryHref={STORYBOOK_URL}
  />

  <section class="container section" aria-labelledby="awards-title">
    <h2 id="awards-title">Awards</h2>
    <div class="awards">
      {awards.map((award) => (
        <Card {...award} />
      ))}
    </div>
  </section>

  <section class="container section" aria-labelledby="skills-title">
    <h2 id="skills-title">Skills</h2>
    <div class="skills">
      {skills.map((group) => (
        <SkillList {...group} />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    margin-top: var(--space-12);
  }

  .awards {
    max-width: 720px;
  }

  .skills {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  }
</style>
