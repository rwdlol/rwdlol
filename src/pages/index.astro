---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero/Hero.astro";
import Card from "../components/Card/Card.astro";
import SkillList from "../components/SkillList/SkillList.astro";
import { mainSite, STORYBOOK_URL } from "../data/site";
import { profile, awards, skills } from "../data/profile";
---

<BaseLayout
  title="Rawand Khalid – Full-stack web developer"
  description="Rawand Khalid is a full-stack web developer: frontend, backend, databases, cloud, DevOps, CMS and server management."
  site={mainSite}
>
  <Hero
    title={profile.name}
    text={profile.intro}
    primaryLabel="View demo website"
    primaryHref="/demo"
    secondaryLabel="Open Storybook"
    secondaryHref={STORYBOOK_URL}
  />

  <section class="container section" aria-labelledby="awards-title">
    <h2 id="awards-title">Awards</h2>
    <div class="awards">
      {awards.map((award) => (
        <Card {...award} />
      ))}
    </div>
  </section>

  <section class="container section" aria-labelledby="skills-title">
    <h2 id="skills-title">Skills</h2>
    <div class="skills">
      {skills.map((group) => (
        <SkillList {...group} />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    margin-top: var(--space-12);
  }

  .awards {
    max-width: 720px;
  }

  .skills {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  }
</style>
