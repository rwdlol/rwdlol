---
const { frontmatter } = Astro.props;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{frontmatter.title}</title>
    <meta name="description" content={frontmatter.description} />
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  @font-face {
    font-display: swap;
    font-family: "Ubuntu";
    font-style: normal;
    font-weight: 400;
    src: url("../fonts/ubuntu-v21-latin-regular.woff2") format("woff2");
  }

  * {
    font-weight: 400;
  }

  :root {
    color-scheme: light dark;
  }

  body {
    max-width: 768px;
    margin: 0 auto;
    padding: 10px;
    line-height: 1.6;
    font-family: "Ubuntu", sans-serif;
    background: light-dark(#fff, #121212);
    color: light-dark(#1a1a1a, #e6e6e6);

    h1,
    h2,
    h3 {
      line-height: 1.2;
    }

    h1,
    h2,
    h3,
    a {
      color: light-dark(#0b57d0, #8ab4f8);
    }

    p {
      text-wrap: pretty;
    }

    ul {
      display: grid;
      grid-template-columns: max-content 1fr;
      gap: 8px 16px;
      margin: 16px 0;
      padding: 0;
      list-style: none;

      li {
        display: grid;
        grid-column: 1 / -1;
        grid-template-columns: subgrid;
      }

      strong {
        color: light-dark(#555, #a0a0a0);
      }
    }
  }
</style>
